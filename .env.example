NODE_ENV=development
PORT=4000

# Public URL of the deployed app, used for CORS in production.
# In single-service deployment you can leave this empty.
CLIENT_ORIGIN=http://localhost:5173

# Database (MySQL).
# Either provide DATABASE_URL or the individual DB_* variables below.
DATABASE_URL=mysql://user:password@host:3306/team_task_manager

# Fallbacks (used only when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=team_task_manager

# Set to true for hosted MySQL (Aiven, PlanetScale, etc.).
DB_SSL=false

# Auth.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Seed user (used by 'npm run seed' to create the bootstrap admin).
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345

# Client (build time).
# In single-service mode the API is same-origin so leave empty.
# For separate-service deployment set this to the API base URL.
VITE_API_BASE_URL=
